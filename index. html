                    </div>
                `;
                totalElement.innerText = formatRupiah(0);
                return;
            }

            let totalPrice = 0;
            container.innerHTML = cart.map((item, index) => {
                const itemTotal = item.price * item.qty;
                totalPrice += itemTotal;
                return `
                    <div class="flex items-center space-x-3 bg-white p-3 rounded-xl border border-slate-200">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg border border-slate-100">
                        <div class="flex-1">
                            <h4 class="font-bold text-xs text-slate-800 line-clamp-1">${item.name}</h4>
                            <span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">Size: ${item.selectedSize}</span>
                            <div class="text-xs font-extrabold text-slate-900 mt-1">${formatRupiah(item.price)}</div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQty(${index}, -1)" class="w-6 h-6 bg-slate-100 hover:bg-slate-200 rounded flex items-center justify-center text-xs font-bold text-slate-700">-</button>
                            <span class="text-xs font-bold text-slate-800 w-4 text-center">${item.qty}</span>
                            <button onclick="changeQty(${index}, 1)" class="w-6 h-6 bg-slate-100 hover:bg-slate-200 rounded flex items-center justify-center text-xs font-bold text-slate-700">+</button>
                            <button onclick="removeItem(${index})" class="text-rose-500 hover:text-rose-700 ml-2 text-xs">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            totalElement.innerText = formatRupiah(totalPrice);
        }

        function changeQty(index, delta) {
            const item = cart[index];
            const product = products.find(p => p.id === item.id);

            if (delta > 0) {
                if (item.qty < product.stock) {
                    item.qty += 1;
                } else {
                    showToast(`Batas stok tercapai (${product.stock} pasang)`, 'error');
                }
            } else {
                item.qty -= 1;
                if (item.qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartBadge();
            renderCartItems();
        }

        function removeItem(index) {
            cart.splice(index, 1);
            updateCartBadge();
            renderCartItems();
        }

        // WhatsApp Checkout Logic
        function checkoutToWhatsApp() {
            if (cart.length === 0) {
                showToast("Keranjang Anda kosong! Silahkan pilih sepatu terlebih dahulu.", 'error');
                return;
            }

            const name = document.getElementById('custName').value.trim();
            const address = document.getElementById('custAddress').value.trim();
            const paymentMethod = document.getElementById('paymentMethod').value;

            if (!name || !address) {
                showToast("Mohon lengkapi Nama dan Alamat Pengiriman!", 'error');
                return;
            }

            const phoneNumber = "6285180815340";
            let totalPrice = 0;

            let message = `Halo Admin *SANRID FASHION*, saya ingin memesan sepatu branded original:\n\n`;
            message += `👤 *Data Pemesan:*\n`;
            message += `• Nama: ${name}\n`;
            message += `• Alamat: ${address}\n`;
            message += `• Metode Pembayaran: *${paymentMethod}*\n\n`;
            message += `👟 *Daftar Pesanan:*\n`;

            cart.forEach((item, idx) => {
                const subtotal = item.price * item.qty;
                totalPrice += subtotal;
                message += `${idx + 1}. *${item.name}*\n`;
                message += `   - Size: ${item.selectedSize}\n`;
                message += `   - Jumlah: ${item.qty} pasang\n`;
                message += `   - Harga: ${formatRupiah(item.price)} x ${item.qty} = ${formatRupiah(subtotal)}\n`;
            });

            message += `\n💰 *Total Pembayaran:* *${formatRupiah(totalPrice)}*\n\n`;
            message += `Mohon infokan langkah pembayaran dan pengirimannya. Terima kasih!`;

            const encodedMessage = encodeURIComponent(message);
            const waUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

            // Open WhatsApp in new tab
            window.open(waUrl, '_blank');
        }

        // Toast Helper
        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
